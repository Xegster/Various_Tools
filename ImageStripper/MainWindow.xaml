<Window x:Class="ImageStripper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageStripper - Image Metadata Remover" Height="780" Width="1150"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- File/Folder Selection -->
        <GroupBox Header="File/Folder Selection" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathTextBox" Grid.Column="0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="5" Margin="0,0,10,0"/>
                    <Button x:Name="BrowseFilesButton" Grid.Column="1"
                            Content="Browse Files..."
                            Padding="15,5"
                            Margin="0,0,5,0"
                            Click="BrowseFilesButton_Click"/>
                    <Button x:Name="BrowseFolderButton" Grid.Column="2"
                            Content="Browse Folder..."
                            Padding="15,5"
                            Margin="0,0,5,0"
                            Click="BrowseFolderButton_Click"/>
                    <Button x:Name="ClearListButton" Grid.Column="3"
                            Content="Clear List"
                            Padding="15,5"
                            Click="ClearListButton_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="RecurseSubfoldersCheckBox"
                              Content="Recurse into subfolders"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"/>
                    <TextBlock Text="You can also drag and drop images or folders onto this window."
                               Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Files + Metadata -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Images" Grid.Column="0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="CheckAllFilesButton" Content="Check All" Padding="8,3"
                                Margin="0,0,5,0" Click="CheckAllFilesButton_Click"/>
                        <Button x:Name="UncheckAllFilesButton" Content="Uncheck All" Padding="8,3"
                                Click="UncheckAllFilesButton_Click"/>
                    </StackPanel>

                    <ListBox x:Name="FileListBox" Grid.Row="1"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="FileListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullPath}" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="FileSummaryTextBlock" Grid.Row="2" Margin="0,6,0,0"
                               Foreground="Gray" FontSize="11" Text="No images loaded."/>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <GroupBox Header="Metadata Tags" Grid.Column="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="SelectAllTagsButton" Content="Select All" Padding="8,3"
                                Margin="0,0,5,4" Click="SelectAllTagsButton_Click"/>
                        <Button x:Name="SelectNoTagsButton" Content="Select None" Padding="8,3"
                                Margin="0,0,5,4" Click="SelectNoTagsButton_Click"/>
                        <Button x:Name="InvertTagsButton" Content="Invert" Padding="8,3"
                                Margin="0,0,5,4" Click="InvertTagsButton_Click"/>
                        <Button x:Name="SelectGpsButton" Content="Select GPS" Padding="8,3"
                                Margin="0,0,15,4" Click="SelectGpsButton_Click"/>
                        <CheckBox x:Name="ShowAllTagsCheckBox"
                                  Content="Show tags from all checked images"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,4"
                                  Checked="ShowAllTagsCheckBox_Changed"
                                  Unchecked="ShowAllTagsCheckBox_Changed"/>
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,4"/>
                        <TextBox x:Name="FilterTextBox" Width="150" Padding="3"
                                 VerticalContentAlignment="Center" Margin="0,0,0,4"
                                 TextChanged="FilterTextBox_TextChanged"/>
                    </WrapPanel>

                    <DataGrid x:Name="TagsDataGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="110"/>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding ValueText}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="55"/>
                            <DataGridTextColumn Header="Query" Binding="{Binding Query}" Width="230"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="TagSummaryTextBlock" Grid.Row="2" Margin="0,6,0,0"
                               Foreground="Gray" FontSize="11" Text="0 tag(s) selected."/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Options and actions -->
        <GroupBox Header="Remove" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CreateBackupCheckBox"
                              Content="Back up originals to a Backup subfolder"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"/>
                    <CheckBox x:Name="PreserveDatesCheckBox"
                              Content="Preserve file dates"
                              IsChecked="True"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgressBar"
                                 Width="200"
                                 Height="20"
                                 Minimum="0"
                                 Visibility="Collapsed"
                                 Margin="0,0,10,0"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Padding="20,5"
                            Click="CancelButton_Click"
                            Visibility="Collapsed"
                            IsEnabled="False"/>
                </StackPanel>

                <Button x:Name="RemoveTagsButton" Grid.Column="2"
                        Content="Remove Selected Tags"
                        Padding="20,8"
                        FontWeight="Bold"
                        IsEnabled="False"
                        Click="RemoveTagsButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Log/Status -->
        <GroupBox Header="Status" Grid.Row="3" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="StatusScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusTextBlock"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="11"/>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="ClearLogButton"
                            Content="Clear Log"
                            Padding="20,4"
                            Click="ClearLogButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
