<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlexManager</AssemblyName>
    <RootNamespace>PlexManager.App</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Phase 5: one self-contained, untrimmed exe (see the publish profile). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>PlexManager</Product>
    <Description>Plex, Trakt, Radarr and Sonarr housekeeping in one window.</Description>

    <!-- The WebView2 package ships WinForms and WPF flavours; only the WinForms one is used. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!-- Keep the published folder to the one exe: the UI is embedded, and these would otherwise sit beside it. -->
    <DebugType>embedded</DebugType>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole UI goes inside the assembly, so the published exe needs nothing beside it. -->
    <EmbeddedResource Include="wwwroot\**\*" />

    <!--
      A Release build publishes the one exe and nothing else. A Debug build also copies wwwroot next to the
      binary, and the host prefers that copy, so a change to a screen shows up without rebuilding the resources.
    -->
    <Content Remove="wwwroot\**" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlexManager.Core\PlexManager.Core.csproj" />
  </ItemGroup>

</Project>
